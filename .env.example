# Copy this file to ".env" and fill in your own values.
# ".env" is gitignored and must never be committed.

# ─── Database ───────────────────────────────────────────────
# MongoDB connection string. Use a MongoDB Atlas cluster (replica
# set) so multi-document transactions work.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ledger?retryWrites=true&w=majority

# ─── Auth ───────────────────────────────────────────────────
# Long random string used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ─── Email (Gmail OAuth2) — OPTIONAL ────────────────────────
# Only needed if you enable real email notifications.
EMAIL_USER=
CLIENT_ID=
CLIENT_SECRET=
REFRESH_TOKEN=
